# Supabase Configuration
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini API Key (Optional if managed by platform)
GEMINI_API_KEY=

# Optional: override the Gemini model(s) tried for chat and vision analysis.
# Comma-separated list, tried in order. Defaults to:
# gemini-flash-latest,gemini-3.6-flash,gemini-2.5-flash
GEMINI_MODEL=

# Optional: override the Gemini embedding model used for semantic search
# (school knowledge base). Defaults to: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
